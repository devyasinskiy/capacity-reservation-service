{
  "name": "program-capacity-service",
  "version": "0.1.0",
  "description": "Program capacity & invoice reservation service (Finverity take-home)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "test:integration": "jest --config test/jest-integration.config.js",
    "token": "ts-node --transpile-only scripts/mint-token.ts",
    "http:tokens": "ts-node --transpile-only http/mint-env.ts",
    "publish": "ts-node --transpile-only scripts/publish-sample.ts",
    "db:migrate": "ts-node --transpile-only src/database/cli.ts migrate",
    "db:rollback": "ts-node --transpile-only src/database/cli.ts rollback",
    "db:seed": "ts-node --transpile-only src/database/cli.ts seed",
    "db:verify-ledger": "ts-node --transpile-only src/database/cli.ts verify-ledger"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "kysely": "^0.28.17",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redpanda": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
