# Copy to .env for `npm run start:dev` against `docker compose up postgres redpanda`.
NODE_ENV=development
HTTP_PORT=3000
# Internal port for /health and /metrics; never exposed publicly (ADR-016)
MANAGEMENT_PORT=9464
LOG_LEVEL=debug
LOG_PRETTY=true
DATABASE_URL=postgres://app:app@localhost:5432/capacity
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
# Program row-lock wait / statement limits; exceeded → 503 + Retry-After (ADR-005)
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=program-capacity
KAFKA_GROUP_ID=program-capacity
KAFKA_TREASURY_TOPIC=treasury.capacity.v1
KAFKA_DLQ_TOPIC=treasury.capacity.v1.dlq
KAFKA_CONSUMER_ENABLED=true
# Partitions (= programs) processed in parallel; order within a partition is preserved
KAFKA_PARTITIONS_CONCURRENCY=4
# Transient failures: exponential backoff with jitter, then DLQ (ADR-012)
KAFKA_RETRY_MAX_ATTEMPTS=5
KAFKA_RETRY_INITIAL_MS=200
KAFKA_RETRY_MAX_MS=5000
# DEV-ONLY keypair committed in dev/jwt (ADR-007); production uses a real issuer/JWKS
JWT_PUBLIC_KEY_PATH=dev/jwt/public.pem
JWT_ISSUER=capacity-dev-issuer
JWT_AUDIENCE=program-capacity-api
JWT_CLOCK_TOLERANCE_SECONDS=30
# Reservation-time FX quotes older than this are refused (ADR-003)
FX_MAX_AGE_SECONDS=3600
# Browser origins allowed to call the API (Swagger UI on the management port)
CORS_ORIGINS=http://localhost:9464
# Reconciliation (ADR-011/020)
RECONCILIATION_GRACE_WINDOW_SECONDS=300
SNAPSHOT_STAGING_TTL_SECONDS=900
SNAPSHOT_SWEEP_INTERVAL_SECONDS=60
