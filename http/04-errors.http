### 8. Malformed reservation id → 400 VALIDATION_FAILED
GET {{api}}/programs/{{programUsd}}/reservations/not-a-uuid
Authorization: Bearer {{token}}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
%}

### 9. Tampered pagination cursor → 400 INVALID_CURSOR
GET {{api}}/programs/{{programUsd}}/reservations?cursor=garbage
Authorization: Bearer {{token}}

> {%
    client.test("400 INVALID_CURSOR", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.code === "INVALID_CURSOR", response.body.code);
    });
%}
